# ── 앱 (EXPO_PUBLIC_ 은 번들에 그대로 들어간다. 주소만 두고 키는 절대 두지 않는다) ──
# 서버를 쓰지 않으면 비워 둬도 된다 — 공개 API 로 직통한다.
EXPO_PUBLIC_API_BASE=http://localhost:8787

# ── 서버 (이 파일은 서버에만 둔다) ──
PORT=8787
# 접근을 좁히려면 배포 주소를 적는다. 비우면 전체 허용.
ALLOWED_ORIGIN=

# 환율을 시간당 갱신하려면 둘 중 하나. 없으면 무료 소스(하루 1회)로 동작한다.
# 무료 등급 월 1,000회 · 시간당 1회면 월 720회라 그대로 들어간다.
OPEN_EXCHANGE_RATES_APP_ID=
EXCHANGERATE_API_KEY=

# 환율을 얼마나 자주 다시 볼지(밀리초). 기본 1시간.
FX_TTL_MS=3600000
