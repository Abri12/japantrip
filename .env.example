# ── 앱 (EXPO_PUBLIC_ 은 번들에 그대로 들어간다. 주소만 두고 키는 절대 두지 않는다) ──
# 서버를 쓰지 않으면 비워 둬도 된다 — 공개 API 로 직통한다.
EXPO_PUBLIC_API_BASE=http://localhost:8787

# ── 서버 (이 파일은 서버에만 둔다) ──
PORT=8787
# 접근을 좁히려면 배포 주소를 적는다. 비우면 전체 허용.
ALLOWED_ORIGIN=

# 환율을 시간당 갱신하려면 둘 중 하나. 없으면 무료 소스(하루 1회)로 동작한다.
# 무료 등급 월 1,000회 · 시간당 1회면 월 720회라 그대로 들어간다.
OPEN_EXCHANGE_RATES_APP_ID=
EXCHANGERATE_API_KEY=

# 환율을 얼마나 자주 다시 볼지(밀리초). 기본 1시간.
FX_TTL_MS=3600000

# 운행정보: JR서일본(간사이)과 도에이 지하철은 키 없이 확인된다.
# 도쿄메트로·JR동일본까지 넓히려면 ODPT 개발자 등록(무료·상업 이용 가능) 후
# 받은 키를 여기 둔다. https://developer.odpt.org
ODPT_TOKEN=

# 지진 감시(WebSocket). 서버를 여러 개 띄울 때만 off — P2PQuake 는 IP당 동시 2연결이다.
QUAKE_WATCH=on
# 푸시 명부 저장 위치. 기본 .data/subscribers.json
SUBSCRIBERS_FILE=

# ── 크레딧 (FEATURES.credits 를 켤 때만 의미가 있다) ──
# 운영자 API(보류 검토·발행 현황). 비우면 해당 경로는 404 로 없는 척한다.
ADMIN_TOKEN=

# 받은 크레딧이 몇 시간 뒤부터 교환 가능한지. 부정 지급을 되돌릴 시간을 번다.
PAYOUT_MATURITY_HOURS=72
# 한 사람이 30일 동안 교환할 수 있는 상한(크레딧)
PAYOUT_WINDOW_LIMIT=5000
# 수령처(전화번호·이메일) 해시 소금. 바꾸면 기존 등록이 전부 풀린다.
PAYOUT_SALT=
# 회선 비교용 해시 소금. IP 원본은 저장하지 않는다.
IP_SALT=

# 발행 한도. 전자금융거래법 등록 면제선(발행잔액 30억원·연간 500억원)보다
# 훨씬 낮게 잡아 사고로 넘어가는 것을 막는다. (server/issuance.mjs)
CREDIT_WON=2
CAP_OUTSTANDING_KRW=100000000
CAP_ANNUAL_KRW=500000000
# 현장 증거 없이 이 금액을 넘겨 확정되면 사람이 본다
HOLD_CREDITS_WITHOUT_ON_SITE=50

# 크레딧 유효기간(일). 기본 1825 = 5년 — 상법상 상사소멸시효와 같고,
# 공정위가 적립식 포인트에 유도하는 수준이다. 오래된 것부터 소진된다.
CREDIT_TTL_DAYS=1825

# 데이터 파일 위치(기본 .data/ 아래)
CONTRIBUTIONS_FILE=
LEDGER_FILE=
PAYOUT_FILE=
