# JapanTrip API — 리버스 프록시 + 자동 TLS
#
# Caddy 를 쓰는 이유는 하나다. **인증서를 잊어버려도 된다.**
# Let's Encrypt 발급과 갱신을 알아서 하고, 갱신에 실패해도 만료 전에 여러 번
# 다시 시도한다. 인증서 만료는 「어느 날 갑자기 앱 전체가 안 되는」 사고인데,
# 90일마다 사람이 기억해야 하는 절차는 언젠가 반드시 어긋난다.
#
# ── 두는 곳 ─────────────────────────────────────────────────
#   /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# ── 주소를 바꿀 것 ──────────────────────────────────────────
# 아래 도메인을 실제 주소로 바꾼다. **IP 로는 안 된다** — Let's Encrypt 는
# IP 주소에 인증서를 안 내준다. 이름이 어디선가는 와야 한다
# (docs/ANDROID-RELEASE.md §2 참고).

japantrip.duckdns.org {
	# 응답이 전부 JSON 이라 압축이 잘 먹는다.
	encode zstd gzip

	reverse_proxy 127.0.0.1:8787 {
		# ── 이 한 줄이 중요하다 ──────────────────────────
		#
		# Caddy 는 기본적으로 클라이언트가 보낸 X-Forwarded-For 뒤에 진짜
		# 주소를 **이어 붙인다.** 그러면 헤더가 이렇게 된다:
		#
		#     X-Forwarded-For: 1.2.3.4, 203.0.113.7
		#                      ~~~~~~~  ~~~~~~~~~~~
		#                      지어낸 것  진짜
		#
		# 서버는 맨 뒤를 읽으므로 이대로도 안전하다. 그래도 갈아끼우는 이유는
		# **방어를 한 겹으로 두지 않기 위해서**다. 서버 쪽 규칙이 언젠가
		# 바뀌어도(맨 앞을 읽게 되어도) 여기서 이미 지어낸 값이 지워져 있다.
		header_up X-Forwarded-For {remote_host}
	}

	# 앱은 브라우저가 아니라서 대부분 무의미하지만, 웹 버전이 같은 서버를
	# 부르게 되면 그때부터 뜻이 생긴다.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /var/log/caddy/japantrip.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
